{
  "name": "project-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:all": "concurrently -k -n api,web,mobile,worker -c blue,green,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:mobile\" \"npm:dev:worker\"",
    "dev:api": "npm run dev --workspace=@starter/api",
    "dev:worker": "npm run dev:worker --workspace=@starter/api",
    "dev:web": "npm run dev --workspace=@starter/web",
    "dev:mobile": "npm run start --workspace=@starter/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
