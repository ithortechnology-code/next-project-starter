COMPOSE_PROJECT_NAME=starter-production
IMAGE_PREFIX=ghcr.io/YOUR_ORG/YOUR_REPOSITORY
IMAGE_TAG=sha-0000000000000000000000000000000000000000
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
OBSERVE_DOMAIN=observe.example.com
DEPLOYMENT_ENVIRONMENT=production
POSTGRES_DB=starter_production
POSTGRES_USER=starter
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ALPHANUMERIC_VALUE
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ZO_ROOT_USER_EMAIL=observability@example.com
ZO_ROOT_USER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MIXED_CASE_DIGIT_AND_SYMBOL_PASSWORD
SMTP_HOST=REPLACE_WITH_PROJECT_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=REPLACE_WITH_PROJECT_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_PROJECT_SMTP_PASSWORD
EMAIL_FROM=no-reply@example.com
STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=starter-files
S3_ACCESS_KEY_ID=REPLACE_WITH_SEPARATE_SEAWEEDFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SEPARATE_SEAWEEDFS_SECRET
FILE_URL_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SIGNING_SECRET
ENABLE_EXAMPLE_FILE_ENDPOINTS=false
