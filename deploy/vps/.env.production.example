COMPOSE_PROJECT_NAME=starter-production
IMAGE_PREFIX=ghcr.io/YOUR_ORG/YOUR_REPOSITORY
IMAGE_TAG=sha-0000000000000000000000000000000000000000
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
OBSERVE_DOMAIN=observe.example.com
DEPLOYMENT_ENVIRONMENT=production
POSTGRES_DB=starter_production
POSTGRES_USER=starter
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ALPHANUMERIC_VALUE
ZO_ROOT_USER_EMAIL=observability@example.com
