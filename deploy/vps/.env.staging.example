COMPOSE_PROJECT_NAME=starter-staging
IMAGE_PREFIX=ghcr.io/YOUR_ORG/YOUR_REPOSITORY
IMAGE_TAG=sha-0000000000000000000000000000000000000000
WEB_DOMAIN=staging.example.com
API_DOMAIN=staging-api.example.com
OBSERVE_DOMAIN=staging-observe.example.com
DEPLOYMENT_ENVIRONMENT=staging
POSTGRES_DB=starter_staging
POSTGRES_USER=starter
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_VALUE
ZO_ROOT_USER_EMAIL=observability@example.com
ZO_ROOT_USER_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ALPHANUMERIC_VALUE
SMTP_HOST=REPLACE_WITH_PROJECT_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=REPLACE_WITH_PROJECT_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_PROJECT_SMTP_PASSWORD
EMAIL_FROM=no-reply@example.com
