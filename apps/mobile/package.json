{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=../../.env ../../node_modules/expo/bin/cli start --port ${EXPO_PORT:-8081}",
    "android": "node --env-file=../../.env ../../node_modules/expo/bin/cli start --android --port ${EXPO_PORT:-8081}",
    "ios": "node --env-file=../../.env ../../node_modules/expo/bin/cli start --ios --port ${EXPO_PORT:-8081}",
    "build": "node ../../node_modules/expo/bin/cli export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check App.tsx"
  },
  "dependencies": {
    "@starter/shared": "*",
    "expo": "58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
