{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --port ${EXPO_PORT:-8081}",
    "android": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --android --port ${EXPO_PORT:-8081}",
    "ios": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --ios --port ${EXPO_PORT:-8081}",
    "build": "node ../../node_modules/expo/bin/cli export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check index.js App.tsx 'components/**/*.tsx' 'lib/**/*.ts' app.json",
    "test:auth": "jest --runInBand"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.24",
    "@starter/shared": "*",
    "expo": "58.0.25",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "58.0.25",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  }
}
