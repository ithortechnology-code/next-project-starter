{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --port ${EXPO_PORT:-8081}",
    "android": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --android --port ${EXPO_PORT:-8081}",
    "ios": "node --import=../../scripts/load-env.mjs ../../node_modules/expo/bin/cli start --ios --port ${EXPO_PORT:-8081}",
    "build": "node ../../node_modules/expo/bin/cli export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check App.tsx"
  },
  "dependencies": {
    "@starter/shared": "*",
    "expo": "58.0.25",
    "expo-status-bar": "~58.0.5",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "58.0.25",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  }
}
