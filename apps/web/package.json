  },
  "dependencies": {
    "@starter/shared": "*",
    "next": "16.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "typescript": "^5.9.3"
  }
