{
  "name": "@starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import=../../scripts/load-env.mjs --import tsx --watch src/server.ts",
    "dev:worker": "node --import=../../scripts/load-env.mjs --import tsx --watch src/worker.ts",
    "db:migrate": "node --import=../../scripts/load-env.mjs --import tsx src/migrate.ts",
    "auth:provision-user": "node --import=../../scripts/load-env.mjs --import tsx src/provision-auth-user.ts",
    "test:email": "node --import=tsx --test src/email.test.ts",
    "test:auth": "node --import=../../scripts/load-env.mjs --import=tsx --test src/auth.integration.test.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "9.9.2",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@starter/shared": "*",
    "@starter/storage": "*",
    "better-auth": "1.7.24",
    "fastify": "^5.6.2",
    "kysely": "0.29.8",
    "nodemailer": "10.5.0",
    "pg": "^8.16.3",
    "pg-boss": "12.35.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.5",
    "auth": "1.7.24",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
